{
  /// Optional: Your Exa API key from https://dashboard.exa.ai/api-keys
  /// (higher rate limits; required for agent_run)
  "exa_api_key": null,
  /// Optional: Comma-separated list of tools to enable — replaces the defaults,
  /// so list every tool you want.
  /// Default (when null): web_search_exa, web_fetch_exa
  /// Available tools: web_search_exa, web_fetch_exa, web_search_advanced_exa,
  ///   agent_run (requires an API key)
  "tools": null
}
